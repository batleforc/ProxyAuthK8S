FROM registry.hub.docker.com/library/rust:1.99-alpine AS build_base

WORKDIR /app
# Set before the dependency build so both cargo invocations share one
# fingerprint: a flag that differs between them recompiles every dependency.
ENV RUSTFLAGS="-C target-feature=-crt-static"
# Alpine packages are not pinned: the base is the floating alpine:3 and its
# repositories drop old versions, so a pin would break the next build.
# hadolint ignore=DL3018
RUN apk add --no-cache clang lld musl-dev git openssl-dev libcrypto3 perl dbus-dev pkgconf


# Prepare the build environment and cache dependencies
RUN mkdir -p libs/server/api/src && \
  mkdir -p libs/server/common/src && \
  mkdir -p libs/server/crd/src && \
  mkdir -p libs/server/trace/src && \
  mkdir -p libs/server/controller/src && \
  mkdir -p libs/server/crd_runtime/src && \
  mkdir -p libs/server/virtual_api/src && \
  mkdir -p libs/server/jwt_validator/src && \
  mkdir -p libs/cli/client_api/src && \
  mkdir -p libs/cli/cli/src && \
  mkdir -p libs/cli/cli_trace/src && \
  mkdir -p apps/server/src && \
  mkdir -p apps/crdgen/src && \
  mkdir -p apps/swaggergen/src && \
  mkdir -p apps/kubectl_proxyauth/src && \
  mkdir -p tests/integration/src && \
  mkdir -p libs/agent/proto/src && \
  mkdir -p libs/agent/pki/src && \
  mkdir -p apps/agent/src && \
  mkdir -p libs/server/api/tests

# Copy Cargo.toml files, and the lockfile so the cached dependencies are the
# locked versions rather than whatever resolves on the day of the build.
COPY Cargo.toml Cargo.lock ./
COPY libs/server/api/Cargo.toml libs/server/api/Cargo.toml
COPY libs/server/common/Cargo.toml libs/server/common/Cargo.toml
COPY libs/server/crd/Cargo.toml libs/server/crd/Cargo.toml
COPY libs/server/trace/Cargo.toml libs/server/trace/Cargo.toml
COPY libs/server/controller/Cargo.toml libs/server/controller/Cargo.toml
COPY libs/server/crd_runtime/Cargo.toml libs/server/crd_runtime/Cargo.toml
COPY libs/server/virtual_api/Cargo.toml libs/server/virtual_api/Cargo.toml
COPY libs/server/jwt_validator/Cargo.toml libs/server/jwt_validator/Cargo.toml

COPY libs/agent/proto/Cargo.toml libs/agent/proto/Cargo.toml
COPY libs/agent/pki/Cargo.toml libs/agent/pki/Cargo.toml

COPY libs/cli/client_api/Cargo.toml libs/cli/client_api/Cargo.toml
COPY libs/cli/cli/Cargo.toml libs/cli/cli/Cargo.toml
COPY libs/cli/cli_trace/Cargo.toml libs/cli/cli_trace/Cargo.toml

COPY apps/server/Cargo.toml apps/server/Cargo.toml
COPY apps/crdgen/Cargo.toml apps/crdgen/Cargo.toml
COPY apps/swaggergen/Cargo.toml apps/swaggergen/Cargo.toml
COPY apps/kubectl_proxyauth/Cargo.toml apps/kubectl_proxyauth/Cargo.toml
COPY apps/agent/Cargo.toml apps/agent/Cargo.toml
COPY tests/integration/Cargo.toml tests/integration/Cargo.toml
# `.cargo/` and not `.` — Docker copies a directory's *contents*, so the bare
# form put config.toml at /app/config.toml where cargo never looks. That config
# sets `target-dir = dist/target`, which is exactly where the final stage copies
# the binaries from, so flattening it broke the build twice over.
COPY .cargo .cargo/

# Placeholder sources so cargo can build and cache the dependencies alone
# (an empty lib.rs: a `fn main` there is dead code and warns once per crate).
# A `[[test]]` declared in a manifest must exist too, or cargo refuses it.
RUN : > libs/server/api/src/lib.rs && \
  : > libs/server/common/src/lib.rs && \
  : > libs/server/crd/src/lib.rs && \
  : > libs/server/trace/src/lib.rs && \
  : > libs/server/controller/src/lib.rs && \
  : > libs/server/crd_runtime/src/lib.rs && \
  : > libs/server/virtual_api/src/lib.rs && \
  : > libs/server/jwt_validator/src/lib.rs && \
  : > libs/cli/client_api/src/lib.rs && \
  : > libs/cli/cli/src/lib.rs && \
  : > libs/cli/cli_trace/src/lib.rs && \
  : > tests/integration/src/lib.rs && \
  : > libs/agent/proto/src/lib.rs && \
  : > libs/agent/pki/src/lib.rs && \
  : > apps/agent/src/lib.rs && \
  : > libs/server/api/tests/http_contract.rs && \
  echo "fn main() {}" > apps/server/src/main.rs && \
  echo "fn main() {}" > apps/crdgen/src/main.rs && \
  echo "fn main() {}" > apps/swaggergen/src/main.rs && \
  echo "fn main() {}" > apps/kubectl_proxyauth/src/main.rs && \
  echo "fn main() {}" > apps/agent/src/main.rs

## Build dependencies
RUN cargo build --release --workspace --locked

COPY . .

# Build the actual binary
FROM build_base AS build_back

# `COPY` keeps the host mtimes, older than the placeholder build above: touch
# every workspace source so cargo does not keep the placeholder crates.
RUN find apps libs tests -path '*/src/*.rs' -exec touch {} + && \
  cargo build --release --workspace --locked && \
  strip dist/target/release/server && \
  strip dist/target/release/crdgen && \
  strip dist/target/release/swaggergen && \
  strip dist/target/release/kubectl_proxyauth

# Final stage
FROM registry.hub.docker.com/library/alpine:3

# hadolint ignore=DL3018
RUN apk add --no-cache libgcc && apk upgrade --no-cache && \
  addgroup -S -g 1000 app && adduser -S -D -H -u 1000 -G app app

WORKDIR /app

COPY --from=build_back /app/dist/target/release/server /app/server
COPY --from=build_back /app/dist/target/release/crdgen /app/crdgen
COPY --from=build_back /app/dist/target/release/swaggergen /app/swaggergen
COPY --from=build_back /app/dist/target/release/kubectl_proxyauth /app/kubectl-proxyauth

EXPOSE 5437

ENV SERVER_PORT=5437
ENV ENV=production

# Same UID/GID as the chart's securityContext; never run as root.
USER 1000:1000

CMD ["/app/server"]
