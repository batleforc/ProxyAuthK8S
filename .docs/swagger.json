  },
  "servers": [
    {
      "url": "/",
      "description": "Current usable server."
    }
  ],
  "paths": {
    "/api/v1/clusters": {
      "get": {
        "tags": [
          "api_clusters"
        ],
        "summary": "Get all cluster visible to the user.",
        "description": "Get all cluster visible to the user,\nif the user is not authenticated return 401,\nif none return an empty array.",
        "operationId": "get_all_visible_cluster",
        "responses": {
          "200": {
            "description": "Get all visible clusters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllVisibleClusterBody"
                }
              }
            }
          },
          "401": {
            "description": "User is not authenticated."
          },
          "429": {
            "description": "Rate limited or banned (see UNSCOPED_* environment knobs)."
          },
          "500": {
            "description": "Internal server error."
          },
          "503": {
            "description": "Redis is unavailable."
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/clusters/{ns}/{cluster}/.well-known/oauth-authorization-server": {
      "get": {
        "tags": [
          "auth_clusters"
        ],
        "summary": "OAuth 2.0 Authorization Server Metadata for the cluster's mediated OAuth Authorization Server",
        "description": "Unauthenticated by nature (RFC 8414 discovery). If the cluster is not\nfound, disabled, or does not have discovery enabled, return 404.",
        "operationId": "oauth_authorization_server",
        "parameters": [
          {
            "name": "ns",
            "in": "path",
            "description": "Namespace containing the cluster.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cluster",
            "in": "path",
            "description": "Cluster name that should exist in the namespace.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OAuth 2.0 authorization server metadata (RFC 8414).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthAuthorizationServerMetadata"
                }
              }
            }
          },
          "404": {
            "description": "Cluster not found, disabled, or discovery not enabled."
          },
          "503": {
            "description": "Cache unreachable."
          }
        }
      }
    },
    "/clusters/{ns}/{cluster}/auth/callback": {
      "get": {
        "tags": [
          "auth_clusters"
        ],
        "summary": "Callback from the cluster's OIDC provider",
        "description": "If the cluster is not found or disabled, return 404.",
        "operationId": "callback_login",
        "parameters": [
          {
            "name": "ns",
            "in": "path",
            "description": "Namespace containing the cluster.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cluster",
            "in": "path",
            "description": "Cluster name that should exist in the namespace.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-front-callback",
            "in": "header",
            "description": "If it's from the frontend, this header will be set.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "x-kubectl-callback",
            "in": "header",
            "description": "If it's from kubectl plugin, this header will be set.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "code",
            "in": "query",
            "description": "Authorization code from the OIDC provider.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "State parameter to prevent CSRF.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response from remote cluster.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallbackModel"
                }
              }
            }
          },
          "400": {
            "description": "Missing or already-used CSRF state."
          },
          "404": {
            "description": "Cluster not found or disabled."
          },
          "429": {
            "description": "Rate limited or banned for this cluster."
          },
          "500": {
            "description": "Internal server error."
          },
          "503": {
            "description": "Redis is unavailable."
          }
        }
      }
    },
    "/clusters/{ns}/{cluster}/auth/login": {
      "get": {
        "tags": [
          "auth_clusters"
        ],
        "summary": "Redirect to the cluster's login page",
        "description": "If the cluster is not found or disabled, return 404.",
        "operationId": "cluster_login",
        "parameters": [
          {
            "name": "ns",
            "in": "path",
            "description": "Namespace containing the cluster.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cluster",
            "in": "path",
            "description": "Cluster name that should exist in the namespace.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-front-callback",
            "in": "header",
            "description": "If it's from the frontend, this header will be set.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "x-kubectl-callback",
            "in": "header",
            "description": "If it's from kubectl plugin, this header will be set.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response from remote cluster.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or unresolvable bearer token."
          },
          "404": {
            "description": "Cluster not found or disabled."
          },
          "429": {
            "description": "Rate limited or banned for this cluster."
          },
          "500": {
            "description": "Internal server error."
          },
          "503": {
            "description": "Redis is unavailable."
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/clusters/{ns}/{cluster}/oauth/authorize": {
      "get": {
        "tags": [
          "auth_clusters"
        ],
        "summary": "Start the mediated OAuth Authorization Server flow for a cluster",
        "description": "Redirects the caller's browser to the cluster's upstream OIDC provider. If\nthe cluster is not found, disabled, or discovery is not enabled, return 404.",
        "operationId": "authorize",
        "parameters": [
          {
            "name": "ns",
            "in": "path",
            "description": "Namespace containing the cluster.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cluster",
            "in": "path",
            "description": "Cluster name that should exist in the namespace.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "response_type",
            "in": "query",
            "description": "Must be `code`; this server only implements the authorization code grant.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "client_id",
            "in": "query",
            "description": "Unvalidated: the proxy mediates the whole flow, so external clients\nnever need to register with the upstream provider.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "description": "Must be a loopback URI (`http://localhost` or `http://127.0.0.1`), any port/path.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "Opaque value echoed back verbatim on redirect.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "code_challenge",
            "in": "query",
            "description": "RFC 7636 PKCE code challenge (43-128 chars, unreserved charset).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "description": "Must be `S256` when present; only S256 is supported.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the upstream identity provider."
          },
          "400": {
            "description": "Malformed authorization request (invalid or non-loopback redirect_uri)."
          },
          "404": {
            "description": "Cluster not found, disabled, or discovery not enabled."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/clusters/{ns}/{cluster}/oauth/callback": {
      "get": {
        "tags": [
          "auth_clusters"
        ],
        "summary": "Callback from the cluster's upstream OIDC provider, for the mediated OAuth Authorization Server flow",
        "description": "Not meant to be opened directly: the upstream provider redirects here after\nthe caller authenticates. On success, redirects to the external client's\nown `redirect_uri` with a proxy-minted authorization code.",
        "operationId": "callback",
        "parameters": [
          {
            "name": "ns",
            "in": "path",
            "description": "Namespace containing the cluster.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cluster",
            "in": "path",
            "description": "Cluster name that should exist in the namespace.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code",
            "in": "query",
            "description": "Authorization code from the upstream OIDC provider.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "The correlation id this proxy generated at `/oauth/authorize`.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the external client's redirect_uri, with a proxy-minted code (or an error)."
          },
          "400": {
            "description": "Unknown or expired state."
          },
          "404": {
            "description": "Cluster not found, disabled, or discovery not enabled."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/clusters/{ns}/{cluster}/oauth/jwks": {
      "get": {
        "tags": [
          "auth_clusters"
        ],
        "summary": "The upstream identity provider's JSON Web Key Set, mirrored under the cluster's own path",
        "description": "Stateless passthrough of the upstream provider's `jwks_uri`, so a caller\nverifying a token never needs to learn or contact the upstream provider's\nown hostname. If the cluster is not found, disabled, or does not have\ndiscovery enabled, return 404.",
        "operationId": "jwks",
        "parameters": [
          {
            "name": "ns",
            "in": "path",
            "description": "Namespace containing the cluster.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cluster",
            "in": "path",
            "description": "Cluster name that should exist in the namespace.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The upstream identity provider's JSON Web Key Set."
          },
          "404": {
            "description": "Cluster not found, disabled, or discovery not enabled."
          },
          "503": {
            "description": "Upstream OIDC provider unreachable or its discovery document is invalid."
          }
        }
      }
    },
    "/clusters/{ns}/{cluster}/oauth/token": {
      "post": {
        "tags": [
          "auth_clusters"
        ],
        "summary": "Exchange a proxy-minted authorization code for the upstream tokens",
        "description": "RFC 6749 §4.1.3 token endpoint. If the cluster is not found, disabled, or\ndiscovery is not enabled, return 404.",
        "operationId": "token",
        "parameters": [
          {
            "name": "ns",
            "in": "path",
            "description": "Namespace containing the cluster.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cluster",
            "in": "path",
            "description": "Cluster name that should exist in the namespace.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Token response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseBody"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request / invalid_grant / unsupported_grant_type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Cluster not found, disabled, or discovery not enabled."
          },
          "503": {
            "description": "Cache unreachable."
          }
        }
      }
    },
