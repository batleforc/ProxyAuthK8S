  "components": {
    "schemas": {
      "CallbackModel": {
        "type": "object",
        "description": "Model for the callback response after successful authentication with the cluster.\n\nThis model contains the access token, refresh token, cluster URL, subject, and ID token returned by the cluster after successful authentication.",
        "required": [
          "access_token",
          "refresh_token",
          "cluster_url",
          "subject",
          "id_token"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "cluster_url": {
            "type": "string"
          },
          "id_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        }
      },
      "GetAllVisibleClusterBody": {
        "type": "object",
        "description": "Body of the response for the `get_all_visible_cluster` endpoint.\n\nContains a list of clusters visible to the user.\nWill be empty if the user has no clusters visible to them.",
        "required": [
          "clusters"
        ],
        "properties": {
          "clusters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VisibleCluster"
            }
          }
        }
      },
      "OAuthAuthorizationServerMetadata": {
        "type": "object",
        "description": "OAuth 2.0 Authorization Server Metadata (RFC 8414) for a proxied cluster.\n\n`issuer` is this proxy's own cluster URL, and so are every other endpoint:\nthis proxy is a full mediating Authorization Server (see\n[`crate::cluster::auth::oauth`]), not a pointer to the cluster's upstream\nOIDC provider. A caller never needs to be registered with — or even learn\nthe hostname of — the upstream provider; the proxy is.",
        "required": [
          "issuer",
          "authorization_endpoint",
          "token_endpoint",
          "jwks_uri",
          "scopes_supported",
          "response_types_supported",
          "grant_types_supported",
          "token_endpoint_auth_methods_supported",
          "code_challenge_methods_supported"
        ],
        "properties": {
          "authorization_endpoint": {
            "type": "string"
