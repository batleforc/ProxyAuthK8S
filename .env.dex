# Dex as the identity provider (see .compose/dex/config.yaml).
#
# Usage: cp .env.dex .env  — then enable the Dex include in compose.yaml.
# Users: dev-admin / dev-admin and dev-user / dev-user.
#
# Self-contained on purpose: `cp` replaces .env wholesale, so everything the
# stack needs has to be here, not only the OIDC overrides.

# Redis PWD
# Must match the sidecar in devfile.yaml and the compose stack, both of which
# read REDIS_PASSWORD as-is.
REDIS_PASSWORD="Complexpass#123"
# The URL cannot interpolate REDIS_PASSWORD: '#' starts a fragment, so the
# password would be silently truncated to "Complexpass". It is percent-encoded
# here instead (%23).
REDIS_URL="redis://:Complexpass%23123@localhost:6379"
# Redis used by the integration tests (see .taskfile/test.yaml).
TEST_REDIS_URL="redis://:Complexpass%23123@localhost:6379"

# OpenObserve
OB_USER_EMAIL="root@example.com"
OB_USER_PASSWORD="Complexpass#123"

# Vite Environment Variables
VITE_API_BASE_URL="https://localhost:5437"
VITE_OIDC_ISSUER_URL="https://dex.k8s.localhost"
VITE_OIDC_CLIENT_ID="proxyauthk8s"
# Dex exposes a real `groups` scope, so the default scope list works as-is.
VITE_OIDC_SCOPE="openid profile email groups"
VITE_OIDC_SILENT_REFRESH="false"

# Backend Environment Variables
## Front OIDC Config
API_OIDC_ISSUER_URL="https://dex.k8s.localhost"
API_OIDC_CLIENT_ID="proxyauthk8s"
API_OIDC_SCOPE="openid profile email groups"
# Dex puts the client id in `aud`, so the audience is just the client id and
# `accept_authorized_party` can stay off.
API_OIDC_AUDIENCE="proxyauthk8s"

## Cluster OIDC Config
API_CLUSTER_OIDC_BASE_REDIRECT_URL="https://localhost:5437"
API_CLUSTER_OIDC_FRONT_REDIRECT_URL="https://localhost:4200"

## CORS: the dev front (https://localhost:4200) calls the API cross-origin
CORS_ALLOWED_ORIGINS="https://localhost:4200"
