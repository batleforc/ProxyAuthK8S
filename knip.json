{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "kubectl",
    "playwright"
  ],
  "ignoreDependencies": [
    "tslib"
  ],
  "workspaces": {
    "apps/front": {
      "playwright": false,
      "entry": [
        "playwright.config.ts",
        "e2e/**/*.ts",
        "e2e-it/**/*.ts"
      ]
    }
  }
}
